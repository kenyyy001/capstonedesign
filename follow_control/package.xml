<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>follow_control</name>
  <version>0.1.0</version>
  <description>Follow controller + serial bridge ke ESP32 untuk robot omniwheel human tracking</description>
  <maintainer email="you@example.com">Keny</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>vision_lock</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
